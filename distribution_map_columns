# no_ylab
p1 <- p1 + ylab(NULL) 
p2 <- p2 + ylab(NULL) 
p3 <- p3 + ylab(NULL)
p4 <- p4 + ylab(NULL)
p5 <- p5 + ylab(NULL)

final_plot <- (p3 | (p4 / p2 + plot_layout(heights = c(6,5))) | 
                 (p1 / p5 + plot_layout(heights = c(4,5)))) +
  plot_layout(widths = c(1,1,1))+
  plot_annotation(
    caption = "Number of comparisons",
    theme = theme(
      plot.caption = element_text(
        hjust = 0.6,
        vjust = 2,
        size = 14,
        face = "bold"
      )
    )
  )+ 
  plot_annotation(tag_levels = list(c("b","c", "d", "e","f"))) & 
  theme(plot.tag = element_text(size = 15, face = "bold"))
