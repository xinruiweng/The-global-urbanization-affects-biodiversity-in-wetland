  )) +
  scale_y_continuous(expand = expansion(mult = c(0, 0.05))) +
  scale_x_discrete(labels = function(x) str_to_sentence(x)) +
  my_theme

p5 <- df %>%
  count(climate) %>%
  mutate(climate = fct_reorder(climate, n)) %>%
  ggplot(aes(x = climate, y = n, fill = climate)) +
