# Load necessary libraries
library(ggplot2)
library(dplyr)
library(patchwork)
library(forcats)
library(stringr)
# Load your CSV data
df <- read.csv("data/data.csv")

# theme
my_theme <- theme_minimal() +
  theme(
    panel.grid = element_blank(),
    axis.line = element_line(color = "grey40", size = 1),
    axis.text.y = element_text(size = 14, face = "bold"),
    axis.text.x = element_text(size = 12.5, face = "bold"),
    legend.position = "none",
    axis.title.x = element_text(color = "black"),
    axis.title.y = element_text(color = "black")
  )

# bar graphs
p1 <- df %>%
  count(income_region) %>%
  mutate(income_region = fct_reorder(income_region, n)) %>%
  ggplot(aes(x = income_region, y = n, fill = income_region)) +
  geom_bar(stat = "identity", width = 0.7) +
  coord_flip() +
  xlab(NULL) + 
  ylab("Number of comparisons") +
  scale_fill_manual(
    values = c(
      "#CDC669",
      "#E0DD79",
      "#EEE685",
      "#FFF68F"
    )
  ) +
  scale_y_continuous(expand = expansion(mult = c(0, 0.05))) +
  my_theme

p2 <- df %>%
  count(scale_grouped) %>%
  mutate(scale_grouped = fct_reorder(scale_grouped, n)) %>%
  ggplot(aes(x = scale_grouped, y = n, fill = scale_grouped)) +
  geom_bar(stat = "identity", width = 0.7) +
  coord_flip() +
  xlab(NULL) + 
  ylab("Number of comparisons") +
  scale_fill_manual(values = c("#483D8B","#8166D0","#A99FE8","#C8BFF0","#E6E0F8")) +
  scale_y_continuous(expand = expansion(mult = c(0, 0.05))) +
  my_theme

p3 <- df %>%
  count(taxa_grouped) %>%
  mutate(taxa_grouped = fct_reorder(taxa_grouped, n)) %>%
  ggplot(aes(x = taxa_grouped, y = n, fill = taxa_grouped)) +
  geom_bar(stat = "identity", width = 0.7) +
  coord_flip() +
  xlab(NULL) + ylab("Number of comparisons") +
  scale_fill_manual(values = c(
    "#1B3A1E",
    "#295C2E",
    "#2E7D32",
    "#3C8F40",
    "#4FA152",
    "#78C578",
    "#8ED68C",
    "#A5E39F",
    "#BDEEB4"
  )) +
  scale_y_continuous(expand = expansion(mult = c(0, 0.05))) +
  scale_x_discrete(labels = function(x) str_to_sentence(x)) +  
  my_theme

p4 <- df %>%
  count(wetland_type_grouped) %>%
  mutate(wetland_type_grouped = fct_reorder(wetland_type_grouped, n)) %>%
  ggplot(aes(x = wetland_type_grouped, y = n, fill = wetland_type_grouped)) +
  geom_bar(stat = "identity", width = 0.7) +
  coord_flip() +
  xlab(NULL) + ylab("Number of comparisons") +
  scale_fill_manual(values = c(
    "#0B2C4A",
    "#0F406C",
    "#1B5F9E",
    "#3A7FC1",
    "#74B1E5",
    "#9FD2F4"
  )) +
  scale_y_continuous(expand = expansion(mult = c(0, 0.05))) +
  scale_x_discrete(labels = function(x) str_to_sentence(x)) + 
  my_theme

p5 <- df %>%
  count(climate) %>%
  mutate(climate = fct_reorder(climate, n)) %>%
  ggplot(aes(x = climate, y = n, fill = climate)) +
  geom_bar(stat = "identity", width = 0.7) +
  coord_flip() +
  xlab(NULL) + ylab("Number of comparisons") +
  scale_fill_manual(values = c(
    "#7F0000",
    "#D7301F",
    "#F2645A",
    "#F9A3A3",
    "#FDE0DD"
  )) +
  scale_y_continuous(expand = expansion(mult = c(0, 0.05))) +
  scale_x_discrete(labels = function(x) str_to_sentence(x)) + 
  my_theme

# no_ylab
p1 <- p1 + ylab(NULL) 
p2 <- p2 + ylab(NULL) 
p3 <- p3 + ylab(NULL)
p4 <- p4 + ylab(NULL)
p5 <- p5 + ylab(NULL)

final_plot <- (p3 | (p4 / p2 + plot_layout(heights = c(6,4))) | 
                 (p1 / p5 + plot_layout(heights = c(4,5)))) +
  plot_layout(widths = c(1,1,1))+
  plot_annotation(
    caption = "Number of comparisons",
    theme = theme(
      plot.caption = element_text(
        hjust = 0.6,
        vjust = 2,
        size = 14,
        face = "bold"
      )
    )
  )+ 
  plot_annotation(tag_levels = list(c("b","c", "d", "e","f"))) & 
  theme(plot.tag = element_text(size = 15, face = "bold"))

